# Copy to .env.local (or add these as Environment Variables in the Vercel dashboard).

# Supabase — required (public, safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://bhdxlmusufwwioghahec.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role — server only, do NOT expose as NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site URL — change to your production domain (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:4028

# Web Push (VAPID) for PWA push notifications — server only keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@brokly.io

# AI Assistant & Copilot (Google Gemini, Groq, OpenAI, etc.)
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# Optional SMS Gateway Integration
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_FROM=Brokly

# Optional SMTP Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Brokly CRM <noreply@brokly.io>

# Optional Analytics & Monetization
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_ADSENSE_ID=